# FormReport — configuração local (copie para .env.local, que não é enviado ao GitHub)
PORT=3000

# Opcional: com as credenciais abaixo a busca usa a Spotify Web API.
# Sem elas, o servidor usa a fonte pública Deezer (que já traz prévias de 30 s).
# Crie um app em https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=BR
SPOTIFY_REQUEST_TIMEOUT_MS=8000
